.navbar
  a.external
    color #2c3e00 !important
  a.external:hover
  a.home-link:hover span
    color $accentColor !important

.nav-links
  .nav-item:nth-child(1)
    display inline-block
    font-size 1.05rem
    padding 0.2rem 1.6rem
    transition background-color 0.1s ease
    color #fff
    background-color $accentColor
    border-radius 4px
    box-sizing border-box
    border-bottom 1px solid darken($accentColor, 20%)
    a.router-link-active
      color #fff !important
      text-decoration none !important
  .nav-item:nth-child(1):hover
    background-color lighten($accentColor, 8%)
    cursor pointer
    a
      color #fff !important
      text-decoration none !important


.home
  .hero
    img
      max-height 40rem !important
      margin 0 !important

  #main-title
    margin-top 0.5rem !important
    margin-bottom 0.5rem !important

  .description
    margin-top 0 !important

.home li,
.meta li
  list-style disc
  margin-left 0.4rem

.meta .theme-default-content:not(.custom) > h2
  margin-top 0
  padding-top 0

.home h1,
.home h2,
.meta h2
  margin-top 1.5rem !important
  margin-bottom 1rem !important

.meta ul
  padding 1rem

.appevents
  margin-top 1rem
  display flex
  flex-wrap wrap
  justify-content space-between
  list-style none

  li
    display flex
    flex-direction column
    align-items center
    text-align center
    flex 0 0 6rem
    width 6rem
    margin 0.5rem
    padding 0
    border-radius 14px
    word-break break-word
    font-size 0.65rem
    line-height 1.15

  li::before
    content ''
    display block
    width 5rem
    height 5rem
    flex-shrink 0
    margin-bottom 0.35rem
    background-size contain
    background-repeat no-repeat
    background-position center

  li.rounded::before
    border-radius 15%
    overflow hidden

  li.acrolotl::before
    background-image url("/images/appicon-acrolotl.png")

  li.acronia::before
